extends layout

block content
    div(ng-app="app", ng-cloak)
        div(layout="row", layout-align="end center", flex)
            md-button(ng-click="dynamicTheme = 'default'") Default
            md-button(ng-click="dynamicTheme = 'altTheme'") altTheme
        div(md-theme="{{dynamicTheme}}",md-theme-watch="")
            app


