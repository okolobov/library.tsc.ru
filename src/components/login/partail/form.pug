form(name="loginForm", ng-submit="loginForm.$valid && $ctrl.login()", enctype="application/x-www-form-urlencoded")
    md-input-container.md-block
        label Имя
        input(type="text", ng-model='$ctrl.identifier', required)

    md-input-container.md-block
        label Пароль 
        input(type="password", ng-model='$ctrl.password', required)

    div
        md-button.md-raised.md-primary(type="submit", ng-disabled="$ctrl.loading") Вход
        md-button.md-raised(type="reset", ng-disabled="$ctrl.loading", ng-click="$ctrl.reset()") Отменить
