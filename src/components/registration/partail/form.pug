.alert.alert-danger(ng-if="$ctrl.error") {{$ctrl.error}}

form(name="form", ng-submit="form.$valid && $ctrl.callRegistration()", enctype="application/x-www-form-urlencoded")


    .form-group(ng-class="{'has-error': form.$submitted && form.identifier.$invalid}")
        label.control-label(for="identifier") Identifier*
        input.form-control(name="identifier", type="text", ng-model='$ctrl.identifier', required, placeholder="identifier", autocomplete="off")

        div(ng-messages="form.$submitted && form.identifier.$error", role="alert")
            div(ng-message="required")
                | Identifier is required*

    .form-group(ng-class="{'has-error': form.$submitted && form.password.$invalid}")
        label.control-label(for="password") Password*
        input.form-control(name="password", type="password", ng-model='$ctrl.password', required, placeholder="password", autocomplete="off")
        div(ng-messages="form.$submitted && form.password.$error", role="alert")
            div(ng-message="required")
                | Password is required*

    .form-group(ng-class="{'has-error': form.$submitted && form.realname.$invalid}")
        label.control-label(for="realname") Realname*
        input.form-control(name="realname", type="text", ng-model='$ctrl.realname', required, placeholder="real name", autocomplete="off")
        div(ng-messages="form.$submitted && form.realname.$error", role="alert")
            div(ng-message="required")
                | Realname is required*

    .form-group(ng-class="{'has-error': form.$submitted && form.email.$invalid}")
        label.control-label(for="email") Email*
        input.form-control(name="email", type="text", ng-model='$ctrl.email', required, placeholder="e-mail address", autocomplete="off")
        div(ng-messages="form.$submitted && form.email.$error", role="alert")
            div(ng-message="required")
                | E-Mail is required*


    .form-group
        ul.list-inline
            li.list-inline-item
                button.btn.btn-primary(type="submit", ng-disabled="false")
                    | Registration
            li.list-inline-item
                button.btn.btn-secondary(type="reset", ng-click="$ctrl.reset()", ng-disabled="false")
                    | Cancel
