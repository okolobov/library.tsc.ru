form(name="registrationForm", ng-submit="registrationForm.$valid && $ctrl.callRegistration()", enctype="application/x-www-form-urlencoded")
    md-input-container.md-block
        label Имя
        input(type="text", ng-model='$ctrl.identifier', required)
        div(ng-messages="registrationForm.identifier.$error", role="alert")

    md-input-container.md-block
        label Пароль 
        input(type="password", ng-model='$ctrl.password', required)

    md-input-container.md-block
        label Электронная почта
        input(type="email", ng-model='$ctrl.email', required)

    div
        md-button.md-raised.md-primary(type="submit", ng-disabled="$ctrl.loading") Регистрация
        md-button.md-raised(type="reset", ng-disabled="$ctrl.loading", ng-click="$ctrl.reset()") Отменить
